# ------------------------------------------------------------------------------
# Bash configuration for Ubuntu, RHEL, Fedora, and macOS.
# Cross‑platform, safe defaults, modern tooling, and quality‑of‑life improvements.
# Includes: enhanced history, OS detection, PATH management, smart aliases,
# tmux auto‑attach, git‑aware prompt, and utility functions.
# ------------------------------------------------------------------------------

# ------------------------------------------------------------------------------
# 1. HISTORY MANAGEMENT
# ------------------------------------------------------------------------------
export HISTSIZE=50000          # Keep 50k commands in memory history
export HISTFILESIZE=100000     # Save 100k commands in ~/.bash_history
export HISTCONTROL=ignoreboth:erasedups  # Ignore duplicates + commands starting with space
export HISTTIMEFORMAT="%F %T " # Add timestamps to history entries

# Avoid duplicate PROMPT_COMMAND entries (prevents infinite growth)
if [[ "$PROMPT_COMMAND" != *"history -a"* ]]; then
    PROMPT_COMMAND="history -a; history -n; $PROMPT_COMMAND"  # Sync history across terminals
fi

shopt -s histappend             # Append history instead of overwriting
shopt -s cmdhist                # Save multi-line commands as one entry
shopt -s checkwinsize           # Auto-update terminal size after each command
shopt -s autocd                 # Allow typing a directory name to cd into it

# ------------------------------------------------------------------------------
# 2. OS DETECTION & ENVIRONMENT
# ------------------------------------------------------------------------------
export OS="$(uname -s)"         # Detect operating system (Linux or macOS)

# Default editor: prefer vim, respect VISUAL, fallback to nano
if command -v vim >/dev/null 2>&1; then
    export EDITOR="${VISUAL:-vim}"   # Use vim unless VISUAL overrides it
else
    export EDITOR="${VISUAL:-nano}"  # Fallback if vim is missing
fi

export LANG='en_US.UTF-8'       # Set language locale
export LC_ALL='en_US.UTF-8'     # Ensure consistent locale behavior

# PATH management helper — adds directory only if it exists and isn't duplicated
path_add() {
    local dir="$1"              # Store argument in a local variable
    [[ -d "$dir" ]] &&          # Check directory exists
    [[ ":$PATH:" != *":$dir:"* ]] && PATH="$dir:$PATH"  # Add only if not already in PATH
}

# Add common binary paths (Linux + macOS)
path_add "$HOME/bin"            # User scripts
path_add "$HOME/.local/bin"     # Python/pip user installs
path_add "/opt/homebrew/bin"    # macOS ARM Homebrew
path_add "/usr/local/bin"       # macOS Intel + Linux local installs
export PATH                     # Export updated PATH

# ------------------------------------------------------------------------------
# 3. ALIASES & TOOLS
# ------------------------------------------------------------------------------
# Modern ls replacement (eza/exa preferred)
if command -v eza >/dev/null 2>&1; then
    alias ls='eza --group-directories-first --icons'         # Better ls with icons
    alias ll='eza -lh --group-directories-first --git'       # Long listing + git info
    alias la='eza -aH --group-directories-first'             # Show all files
    alias lt='eza --tree'                                    # Directory tree view
elif command -v exa >/dev/null 2>&1; then
    alias ls='exa --group-directories-first'                 # exa fallback
    alias ll='exa -lh'                                       # Long listing
    alias la='exa -a'                                        # Show all files
else
    case "$OS" in
        Darwin) alias ls='ls -G' ;;                          # macOS ls with color
        *)      alias ls='ls --color=auto' ;;                # Linux ls with color
    esac
    alias ll='ls -lh'                                        # Long listing
    alias la='ls -A'                                         # Show hidden files
fi

# Navigation shortcuts
alias ..='cd ..'                # Go up one directory
alias ...='cd ../..'            # Go up two directories

# Safer versions of common commands
alias grep='grep --color=auto'  # Highlight search matches
alias df='df -h'                # Human-readable disk usage
alias du='du -h'                # Human-readable directory size
alias cp='cp -iv'               # Interactive + verbose copy
alias mv='mv -iv'               # Interactive + verbose move
alias rm='rm -iv'               # Interactive + verbose delete
alias mkdir='mkdir -p'          # Create nested directories automatically

# OS-specific open command
case "$OS" in
    Linux)  alias open='xdg-open' ;;  # Open files/apps on Linux
    Darwin) alias open='open' ;;      # Open files/apps on macOS
esac

# Tmux helpers
alias t='tmux'                  # Short tmux command
alias ta='tmux attach -t'       # Attach to a session
alias tn='tmux new -s'          # Create new session
alias tls='tmux ls'             # List sessions

# Auto attach tmux only for interactive shells
if command -v tmux >/dev/null 2>&1 &&   # Ensure tmux exists
   [[ -z "$TMUX" ]] &&                  # Ensure not already inside tmux
   [[ $- == *i* ]]; then                # Ensure shell is interactive
    tmux attach -t main 2>/dev/null || tmux new -s main  # Attach or create session
fi

# ------------------------------------------------------------------------------
# 4. PROMPT (PS1)
# ------------------------------------------------------------------------------
# Fast git branch detection (works even in detached HEAD)
parse_git_branch() {
    git symbolic-ref --short HEAD 2>/dev/null ||  # Normal branch
    git rev-parse --short HEAD 2>/dev/null        # Detached HEAD fallback
}

# Color codes for prompt
CLR_RESET='

\[\e[0m\]

'            # Reset color
CLR_USER='

\[\e[32m\]

'            # Green for user@host
CLR_DIR='

\[\e[34m\]

'             # Blue for directory
CLR_GIT='

\[\e[33m\]

'             # Yellow for git branch

# Prompt: user@host:directory (branch) $
PS1="${CLR_USER}\u@\h${CLR_RESET}:${CLR_DIR}\w${CLR_GIT} \$(parse_git_branch)${CLR_RESET}\$ "

# ------------------------------------------------------------------------------
# 5. FUNCTIONS
# ------------------------------------------------------------------------------
mkcd() {
    mkdir -p "$1" && cd "$1"     # Create directory and enter it
}

extract() {
  if [[ -f "$1" ]]; then         # Ensure file exists
    case "$1" in
      *.tar.bz2)   tar xvjf "$1" ;;   # Extract tar.bz2
      *.tar.gz)    tar xvzf "$1" ;;   # Extract tar.gz
      *.bz2)       bunzip2 "$1" ;;    # Extract bz2
      *.rar)       unrar x "$1" ;;    # Extract rar
      *.gz)        gunzip "$1" ;;     # Extract gz
      *.tar)       tar xvf "$1" ;;    # Extract tar
      *.tbz2)      tar xvjf "$1" ;;   # Extract tbz2
      *.tgz)       tar xvzf "$1" ;;   # Extract tgz
      *.zip)       unzip "$1" ;;      # Extract zip
      *.Z)         uncompress "$1" ;; # Extract Z
      *.7z)        7z x "$1" ;;       # Extract 7z
      *)           echo "'$1' cannot be extracted" ;;  # Unsupported format
    esac
  else
    echo "'$1' is not a valid file"   # File not found
  fi
}
